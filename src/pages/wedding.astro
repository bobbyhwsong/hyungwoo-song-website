      .cover.opened .envelope-flap{z-index:5!important;opacity:.92!important;transform:rotateX(178deg) translateY(-82px) scaleX(.96) scaleY(.84)!important;filter:drop-shadow(0 -8px 12px rgba(0,0,0,.13))!important}

      .cover.zooming .photo-card{z-index:7!important;transform:translate(-50%,-48%) scale(2.28)!important}
      .cover.zooming .envelope-flap{z-index:5!important;opacity:.48!important;transform:rotateX(178deg) translateY(-82px) scaleX(.96) scaleY(.84)!important}


      /* Hinge alignment: flap shares the pocket edge, then lifts enough to remain visible behind the photo. */
      .envelope-back,.envelope-pocket{height:68%!important}
      .envelope-back,.envelope-pocket{background-size:100% auto!important;background-position:center bottom!important}
      .envelope-flap{top:32%!important;height:48%!important;border-top:0!important;transform-origin:50% 0!important;background-size:100% auto!important;background-position:center top!important}
      .envelope-flap:after{top:0!important;height:1px!important;background:rgba(17,17,17,.14)!important;box-shadow:0 1px 0 rgba(255,255,255,.46)!important}
      .envelope-pocket:before{top:0!important;height:1px!important;background:rgba(17,17,17,.14)!important;box-shadow:0 1px 0 rgba(255,255,255,.46),0 3px 8px rgba(17,17,17,.035)!important}
      .cover.opened .envelope-flap{z-index:5!important;opacity:.92!important;transform:rotateX(178deg) translateY(-82px) scaleX(.96) scaleY(.84)!important;filter:drop-shadow(0 -8px 12px rgba(0,0,0,.13))!important}
      .cover.opened .photo-card{z-index:7!important;width:75%!important;transform:translate(-50%,-34%) scale(1)!important}
      .cover.zooming .envelope-flap{z-index:5!important;opacity:.48!important;transform:rotateX(178deg) translateY(-82px) scaleX(.96) scaleY(.84)!important}


      /* Keep hinge and pocket top line moving together after the envelope opens */
      .envelope{transition:transform .55s ease,opacity .55s ease}
