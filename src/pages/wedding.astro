      .cover.zooming .envelope-flap{transform:rotateX(178deg) translateY(-1px)!important;filter:drop-shadow(0 -2px 3px rgba(17,17,17,.04))!important}

      .cover{grid-template-rows:.82fr auto auto auto .9fr;gap:14px;padding:36px 24px 30px}.cover-title{align-self:end;text-align:center;color:#111;letter-spacing:-.02em;animation:titleIn .9s ease both}.cover-korean{font-family:var(--serif);font-size:clamp(1.25rem,5.8vw,1.82rem);font-weight:400;letter-spacing:.16em;text-indent:.16em;line-height:1}.cover-rule{width:34px;height:1px;background:#111;margin:20px auto 18px;opacity:.75}.cover-date-text{font-family:var(--serif);font-size:clamp(1.05rem,4.6vw,1.42rem);font-weight:400;letter-spacing:.08em;line-height:1}.cover-names{margin-top:14px;font-size:clamp(1rem,4.2vw,1.28rem);font-weight:560;letter-spacing:.04em}.cover-names span{font-family:var(--serif);font-weight:400;margin:0 .32em}.envelope-button{align-self:start;margin-top:44px}.cover-hint{align-self:start;margin-top:-8px;color:#555;font-size:.82rem;letter-spacing:-.02em}.cover-made{align-self:start;margin-top:-4px;color:#e8d982;font-size:.72rem;font-weight:760;letter-spacing:.18em}@keyframes titleIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}

      /* Center the whole cover composition, not only the envelope. */
