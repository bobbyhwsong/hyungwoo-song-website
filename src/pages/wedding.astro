      .cover.opened .envelope-flap{transform:rotateX(178deg) translateY(-1px)!important;transition:transform .82s cubic-bezier(.18,.82,.23,1)!important}
      .cover.zooming .envelope-flap{transform:rotateX(178deg) translateY(-1px)!important;opacity:.55!important}


      /* Slightly larger photo card after envelope opens */
      .photo-card{width:75%}
      .cover.opened .photo-card{width:75%!important}
      .cover.zooming .photo-card{transform:translate(-50%,-48%) scale(2.16)!important}

      /* Classic envelope layout used both in the cover and OG thumbnail. */
      .envelope-button{aspect-ratio:38/17!important;max-height:220px!important}
      .envelope-back,.envelope-pocket{top:0!important;bottom:auto!important;height:100%!important;background-color:#f4efe4!important;background-image:radial-gradient(circle at 12px 12px,#607f99 0 3px,transparent 3.35px),radial-gradient(circle at 40px 34px,#607f99 0 3px,transparent 3.35px)!important;background-size:56px 46px!important;background-position:center!important;border:1.2px solid rgba(17,17,17,.18)!important;box-shadow:0 18px 42px rgba(0,0,0,.11)!important}
      .envelope-back{border:0!important;box-shadow:none!important;opacity:.92!important}
      .envelope-pocket:before{display:none!important}
      .envelope-flap{top:0!important;height:41%!important;background-color:#faf7ef!important;background-image:radial-gradient(circle at 12px 12px,#607f99 0 3px,transparent 3.35px),radial-gradient(circle at 40px 34px,#607f99 0 3px,transparent 3.35px)!important;background-size:56px 46px!important;background-position:center top!important;clip-path:polygon(0 0,100% 0,100% 41%,50% 100%,0 41%)!important;border:0!important;filter:drop-shadow(0 2px 1px rgba(17,17,17,.07))!important;transform-origin:50% 0!important}
