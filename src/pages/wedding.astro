    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script>
      const cover = document.getElementById('cover');
      const venueLatLng = [37.5105716, 126.9013946];
      const mapEl = document.getElementById('weddingMap');
      const initKakaoMap = () => {
        const venue = new kakao.maps.LatLng(venueLatLng[0], venueLatLng[1]);
        const weddingMap = new kakao.maps.Map(mapEl, { center: venue, level: 3 });
        const marker = new kakao.maps.Marker({ position: venue, map: weddingMap });
        const infoWindow = new kakao.maps.InfoWindow({
          content: '<div style="padding:10px 12px;font-size:13px;line-height:1.45;white-space:nowrap"><strong style="display:block;margin-bottom:3px">천주교 도림동성당</strong>서울 영등포구 도영로22길 22</div>'
        });
        infoWindow.open(weddingMap, marker);
        kakao.maps.event.addListener(marker, 'click', () => infoWindow.open(weddingMap, marker));
        const zoomControl = new kakao.maps.ZoomControl();
        weddingMap.addControl(zoomControl, kakao.maps.ControlPosition.RIGHT);
      };
      if (mapEl && window.kakao?.maps) {
        kakao.maps.load(initKakaoMap);
      } else if (mapEl && window.naver?.maps) {
        const venue = new naver.maps.LatLng(venueLatLng[0], venueLatLng[1]);
        const weddingMap = new naver.maps.Map(mapEl, {
          center: venue,
          zoom: 16,
          minZoom: 10,
          zoomControl: true,
          zoomControlOptions: { position: naver.maps.Position.TOP_RIGHT }
        });
        const marker = new naver.maps.Marker({ position: venue, map: weddingMap, title: '천주교 도림동성당' });
        const infoWindow = new naver.maps.InfoWindow({
          content: '<div style="padding:10px 12px;font-size:13px;line-height:1.45"><strong style="display:block;margin-bottom:3px">천주교 도림동성당</strong>서울 영등포구 도영로22길 22</div>'
        });
        infoWindow.open(weddingMap, marker);
        naver.maps.Event.addListener(marker, 'click', () => infoWindow.open(weddingMap, marker));
      } else if (mapEl && window.L) {
        const weddingMap = L.map(mapEl, { scrollWheelZoom: false, tap: true }).setView(venueLatLng, 16);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
          maxZoom: 19,
          attribution: '&copy; OpenStreetMap'
        }).addTo(weddingMap);
        L.marker(venueLatLng).addTo(weddingMap)
          .bindPopup('<strong>천주교 도림동성당</strong>서울 영등포구 도영로22길 22')
          .openPopup();
      }
      const openInvitation = () => {
        if (!cover || cover.classList.contains('opened')) return;
        cover.classList.add('opened');
        window.setTimeout(() => cover.classList.add('zooming'), 760);
        window.setTimeout(() => {
          cover.classList.add('done');
          document.body.classList.remove('opening');
          document.body.classList.add('body-ready');
          window.scrollTo({ top: 0, behavior: 'instant' });
        }, 1400);
      };
      document.getElementById('openInvitation')?.addEventListener('click', openInvitation);
      cover?.addEventListener('click', (event) => { if (event.target === cover) openInvitation(); });
      document.addEventListener('contextmenu', (event) => { if (event.target.closest?.('.protected-photo,.photo-card,.photo-modal,.collage-frame')) event.preventDefault(); });
      document.addEventListener('dragstart', (event) => { if (event.target.closest?.('.protected-photo,.photo-card,.photo-modal,.collage-frame')) event.preventDefault(); });
      const photoModal = document.getElementById('photoModal');
      const modalPhoto = document.getElementById('modalPhoto');
      const modalPhotoLabel = document.getElementById('modalPhotoLabel');
      const modalCounter = document.getElementById('modalCounter');
      const photoUrls = ['/assets/wedding-photos/w-iKjULZ5A9AH4gmyu.jpg', '/assets/wedding-photos/w-TUfUaKvOUpjeKoUS.jpg', '/assets/wedding-photos/w-gRm4fPlb2RWVe9PA.jpg', '/assets/wedding-photos/w-LGXKoVIacknGwn2K.jpg', '/assets/wedding-photos/w-gKQS8ms7ajq9cdEK.jpg', '/assets/wedding-photos/w-YuurLbRiuROmPZ2R.jpg', '/assets/wedding-photos/w-AxQSnnuCd9bZwMr8.jpg', '/assets/wedding-photos/w-TppTgyyglEbBZjlB.jpg', '/assets/wedding-photos/w-uYD6LVaddbRiRTUZ.jpg', '/assets/wedding-photos/w-pSpOOIksmhgyF8Gr.jpg', '/assets/wedding-photos/w-exdN2NV0BLhjgf91.jpg', '/assets/wedding-photos/w-VhoH8QqPJKurcwNP.jpg', '/assets/wedding-photos/w-x26ec4xQsUvK38iM.jpg', '/assets/wedding-photos/w-VLR4lvxiMS5zyVOt.jpg', '/assets/wedding-photos/w-2Sn3LPREvO9re7ad.jpg', '/assets/wedding-photos/w-ccovYOg03byc1bUZ.jpg', '/assets/wedding-photos/w-jOu2Gvu9TstvNyBf.jpg', '/assets/wedding-photos/w-D46o0nLCduvoxtsj.jpg', '/assets/wedding-photos/w-1hgw9mjY75q7GDRx.jpg', '/assets/wedding-photos/w-CAKHHyvOYkpVFmKE.jpg', '/assets/wedding-photos/w-E1KAZX0LhCy8hxPx.jpg', '/assets/wedding-photos/w-LqRRSQBBbvxdI35g.jpg', '/assets/wedding-photos/w-QMDxCNGR8uOFYa1U.jpg', '/assets/wedding-photos/w-frYj7Z11M6daBRrm.jpg', '/assets/wedding-photos/w-wyQxCsxSiNRq2hTt.jpg', '/assets/wedding-photos/w-c6I5ayZmVxerx7PH.jpg', '/assets/wedding-photos/w-UORG1QgcUVqaMJEV.jpg', '/assets/wedding-photos/w-yD1EVqkJpS0ipKYx.jpg', '/assets/wedding-photos/w-Ykhuslb5u3Qx24Hq.jpg'];
      const totalPhotos = photoUrls.length;
      const preloadedPhotos = new Set();
      const preloadPhoto = (index) => {
        const normalized = (index + totalPhotos) % totalPhotos;
        if (preloadedPhotos.has(normalized)) return;
        preloadedPhotos.add(normalized);
        const image = new Image();
        image.decoding = 'async';
        image.src = photoUrls[normalized];
      };
      const preloadNearbyPhotos = (index) => {
        [-2, -1, 0, 1, 2].forEach((delta) => preloadPhoto(index + delta));
      };
      let currentPhoto = 0;
      let mosaicPhotoIndex = -1;
      const renderMosaic = async () => {
        if (!modalPhoto || !photoModal?.classList.contains('zoom-protect') || mosaicPhotoIndex === currentPhoto) return;
        mosaicPhotoIndex = currentPhoto;
        const source = photoUrls[currentPhoto];
        try {
          const image = new Image();
          image.decoding = 'async';
          image.src = source;
          await image.decode();
          const canvas = document.createElement('canvas');
          const shortSide = 34;
          const ratio = image.width / image.height;
          canvas.width = ratio >= 1 ? Math.round(shortSide * ratio) : shortSide;
          canvas.height = ratio >= 1 ? shortSide : Math.round(shortSide / ratio);
          const ctx = canvas.getContext('2d');
          ctx.imageSmoothingEnabled = false;
          ctx.drawImage(image, 0, 0, canvas.width, canvas.height);
          modalPhoto.style.setProperty('--mosaic-photo', `url("${canvas.toDataURL('image/jpeg', 0.82)}")`);
        } catch {
          modalPhoto.style.setProperty('--mosaic-photo', `url("${source}")`);
        }
      };
      const updateZoomProtection = () => {
        const scale = window.visualViewport?.scale || 1;
        const zoomed = photoModal?.classList.contains('show') && scale > 2;
        photoModal?.classList.toggle('zoom-protect', Boolean(zoomed));
        if (zoomed) renderMosaic();
        else { mosaicPhotoIndex = -1; modalPhoto?.style.removeProperty('--mosaic-photo'); }
      };
      const renderPhoto = () => {
        if (!modalPhoto || !modalPhotoLabel || !modalCounter) return;
        const url = photoUrls[currentPhoto];
        modalPhoto.classList.remove('main-photo');
        modalPhoto.classList.add('has-real-photo');
        modalPhoto.style.setProperty('--modal-photo', `url("${url}")`);
        modalPhotoLabel.textContent = `PHOTO ${String(currentPhoto + 1).padStart(2, '0')}`;
        modalCounter.textContent = `${currentPhoto + 1} / ${totalPhotos}`;
        mosaicPhotoIndex = -1;
        modalPhoto.style.removeProperty('--mosaic-photo');
        preloadNearbyPhotos(currentPhoto);
        updateZoomProtection();
      };
      const openPhoto = (index = 0) => {
        currentPhoto = (index + totalPhotos) % totalPhotos;
        renderPhoto();
        photoModal?.classList.add('show');
        photoModal?.setAttribute('aria-hidden','false');
        updateZoomProtection();
      };
      const closePhoto = () => { photoModal?.classList.remove('show','zoom-protect'); photoModal?.setAttribute('aria-hidden','true'); modalPhoto?.style.removeProperty('--mosaic-photo'); };
      const movePhoto = (delta) => { currentPhoto = (currentPhoto + delta + totalPhotos) % totalPhotos; renderPhoto(); };
      document.querySelectorAll('[data-photo-index]').forEach((tile) => {
        tile.addEventListener('click', () => openPhoto(Number(tile.dataset.photoIndex || 0)));
        tile.addEventListener('keydown', (event) => { if (event.key === 'Enter' || event.key === ' ') { event.preventDefault(); openPhoto(Number(tile.dataset.photoIndex || 0)); } });
      });
      document.querySelector('.postcard-photo')?.addEventListener('click', () => openPhoto(0));
      modalPhoto?.addEventListener('click', (event) => { event.stopPropagation(); });
      document.querySelector('.modal-nav.prev')?.addEventListener('click', (event) => { event.stopPropagation(); movePhoto(-1); });
      document.querySelector('.modal-nav.next')?.addEventListener('click', (event) => { event.stopPropagation(); movePhoto(1); });
      photoModal?.addEventListener('click', (event) => { if (event.target === photoModal) closePhoto(); });
      document.querySelector('.modal-close')?.addEventListener('click', closePhoto);
      document.addEventListener('keydown', (event) => {
        if (!photoModal?.classList.contains('show')) return;
        if (event.key === 'Escape') closePhoto();
        if (event.key === 'ArrowLeft') movePhoto(-1);
        if (event.key === 'ArrowRight') movePhoto(1);
      });
      window.visualViewport?.addEventListener('resize', updateZoomProtection);
      window.visualViewport?.addEventListener('scroll', updateZoomProtection);
      window.addEventListener('resize', updateZoomProtection);
      const voiceStatus = document.getElementById('voiceStatus');
      const speakTexts = {
        place: '송형우와 강혜진의 결혼식에 초대합니다. 예식은 이천이십육년 시월 이십사일 토요일 오후 열두 시, 천주교 도림동성당에서 있습니다. 주소는 서울 영등포구 도영로 이십이길 이십이입니다.',
        route: '오시는 길 안내입니다. 대중교통 이용 시, 신도림역 이번 출구에서는 마을버스 영등포 공팔번을 타고 대우미래사랑 정류장에서 하차하신 뒤 도보 삼분입니다. 셔틀버스는 신도림역 이번 출구 마을버스 정류장 맨 끝에서 탑승하실 수 있으며, 봉사자 안내 하에 십분 간격으로 운행됩니다. 예식 전 한 시간과 예식 후 두 시간 이용 가능합니다. 영등포역 이번 출구에서는 마을버스 영등포 공구번을 타고 우성오차아파트 정류장에서 하차하신 뒤 도보 칠분입니다. 도보에는 오르막이 있어, 이동이 불편하신 분들은 셔틀버스 이용을 권장드립니다. 자가용은 내비게이션에 도림동성당 또는 서울 영등포구 도영로 이십이길 이십이를 검색해 주세요. 주차 가능하나 혼잡할 수 있어 셔틀버스 이용을 권장드립니다.',
        gift: '마음 전하실 곳 안내입니다. 신랑측은 송윤상, 이정은, 송형우 계좌를 각각 확인하실 수 있고, 신부측은 강기원, 한정원, 강혜진 계좌를 각각 확인하실 수 있습니다. 꽃 화환은 정중히 사양합니다. 혹 마음을 전하고 싶으신 경우 쌀화환으로 보내주시면 어려운 이웃에게 소중히 전달하겠습니다. 식사는 예식 시작 삼십분 전부터 예식 후 두 시간까지 이용하실 수 있습니다. 편안한 마음으로 함께해 주세요.',
        closing: '저희의 새로운 시작에 관심을 가져주시는 그 마음만으로도 저희에게는 큰 기쁨입니다. 그날 귀한 걸음으로 함께해 주신다면 감사한 마음으로 오래도록 기억하겠습니다.'
      };
      speakTexts.all = [speakTexts.place, speakTexts.route, speakTexts.gift, speakTexts.closing].join(' ');
      const getPreferredKoreanVoice = () => {
        const voices = window.speechSynthesis.getVoices?.() || [];
        const koreanVoices = voices.filter((voice) => /^ko([-_]|$)/i.test(voice.lang || ''));
        if (!koreanVoices.length) return null;
        const scoreVoice = (voice) => {
          const name = (voice.name || '').toLowerCase();
          let score = 0;
          if (voice.localService) score += 40; // screen-reader-like: use the device's installed system voice when possible.
          if (voice.lang === 'ko-KR') score += 20;
          if (/yuna|유나|sora|소라|siri|apple|premium|enhanced|neural|natural/i.test(voice.name || '')) score += 18;
          if (/google|microsoft|online/i.test(name)) score -= 4;
          return score;
        };
        return koreanVoices.sort((a, b) => scoreVoice(b) - scoreVoice(a))[0];
      };
      const ensureVoicesReady = () => new Promise((resolve) => {
        if (!window.speechSynthesis?.getVoices) return resolve();
        if (window.speechSynthesis.getVoices().length) return resolve();
        const finish = () => { window.speechSynthesis.removeEventListener?.('voiceschanged', finish); resolve(); };
        window.speechSynthesis.addEventListener?.('voiceschanged', finish, { once: true });
        window.setTimeout(finish, 700);
      });
      const speakGuide = async (key) => {
        if (!('speechSynthesis' in window) || !window.SpeechSynthesisUtterance) {
          if (voiceStatus) voiceStatus.textContent = '이 기기에서는 음성 안내를 지원하지 않습니다.';
          return;
        }
        window.speechSynthesis.cancel();
        if (key === 'stop') {
          if (voiceStatus) voiceStatus.textContent = '음성 안내를 멈췄습니다.';
          return;
        }
        await ensureVoicesReady();
        const utterance = new SpeechSynthesisUtterance(speakTexts[key] || speakTexts.all);
        const preferredVoice = getPreferredKoreanVoice();
        utterance.lang = 'ko-KR';
        if (preferredVoice) utterance.voice = preferredVoice;
        utterance.rate = 0.86;
        utterance.pitch = 0.98;
        utterance.volume = 1;
        utterance.onstart = () => { if (voiceStatus) voiceStatus.textContent = '음성 안내를 재생하고 있습니다.'; };
        utterance.onend = () => { if (voiceStatus) voiceStatus.textContent = '음성 안내가 끝났습니다.'; };
        utterance.onerror = () => { if (voiceStatus) voiceStatus.textContent = '음성 안내를 재생하지 못했습니다.'; };
        window.speechSynthesis.speak(utterance);
      };
      document.querySelectorAll('[data-speak]').forEach((button) => {
        button.addEventListener('click', () => speakGuide(button.dataset.speak || 'all'));
      });
      const largeTextToggle = document.getElementById('largeTextToggle');
      const setLargeText = (enabled) => {
        document.body.classList.toggle('large-text', enabled);
        try { localStorage.setItem('weddingLargeText', enabled ? '1' : '0'); } catch {}
        const label = enabled ? '기본 글씨로 보기' : '큰 글씨로 보기';
        if (largeTextToggle) largeTextToggle.textContent = label;
      };
      const params = new URLSearchParams(window.location.search);
      let savedLargeText = false;
      try { savedLargeText = localStorage.getItem('weddingLargeText') === '1'; } catch {}
      setLargeText(params.get('large') === '1' || savedLargeText);
      largeTextToggle?.addEventListener('click', () => setLargeText(!document.body.classList.contains('large-text')));
      const target = new Date('2026-10-24T12:00:00+09:00').getTime();
      const ids = ['d','h','m','s'].map((id) => document.getElementById(id));
      function tick(){
        const diff = Math.max(0, target - Date.now());
        const d = Math.floor(diff / 86400000);
        const h = Math.floor((diff % 86400000) / 3600000);
        const m = Math.floor((diff % 3600000) / 60000);
        const s = Math.floor((diff % 60000) / 1000);
        [d,h,m,s].forEach((v,i)=>{ if(ids[i]) ids[i].textContent = String(v).padStart(i ? 2 : 1,'0'); });
      }
      tick(); setInterval(tick, 1000);
      document.querySelectorAll('.copy,.contact-copy').forEach((btn)=>{
        btn.addEventListener('click', async ()=>{
          const isContact = btn.classList.contains('contact-copy');
          const strong = isContact ? btn.querySelector('strong') : null;
          const original = isContact ? strong?.textContent : btn.textContent;
          const setLabel = (text) => { if (isContact && strong) strong.textContent = text; else btn.textContent = text; };
          try { await navigator.clipboard.writeText(btn.dataset.copy || ''); setLabel('복사 완료'); setTimeout(()=>setLabel(original || '복사'),1200); }
          catch { setLabel('복사 실패'); setTimeout(()=>setLabel(original || '복사'),1200); }
        });
      });
    </script>
  </body>
</html>
