      /* Photo viewing: allow enlargement, but keep preview intentionally soft rather than protected. */
      .protected-photo:after,.modal-photo:after{content:none!important;display:none!important}.modal-photo,.modal-photo:before{filter:blur(.55px) saturate(.88) contrast(.96);image-rendering:auto}.modal-photo.main-photo{aspect-ratio:1338/988;background-color:transparent;background-image:var(--main-photo);background-size:contain;background-repeat:no-repeat;background-position:center;border:0;border-radius:0;box-shadow:none;filter:none;cursor:default}.modal-photo.main-photo:before{content:none}.modal-photo.main-photo span{display:none}.modal-photo{cursor:default}.countdown-label{margin:16px 0 -4px;color:var(--muted);font-size:.86rem;text-align:center;letter-spacing:-.02em}
      .collage-frame:before{background-image:var(--photo)!important;background-size:contain!important;background-repeat:no-repeat!important;background-position:center!important;filter:saturate(.96) contrast(.98)}.collage-frame:after{content:none!important}.collage-frame span{display:none}.f7:before{background-position:center top!important}.modal-photo.has-real-photo{aspect-ratio:3/4;width:min(100%,calc(82svh * .75));max-height:82svh;margin:0 auto;background-image:var(--modal-photo);background-size:contain;background-repeat:no-repeat;background-position:center;background-color:transparent;border:0;border-radius:0;box-shadow:none;filter:none;cursor:default}.modal-photo.has-real-photo:before{content:none}.modal-photo.has-real-photo span{display:none}.photo-modal.zoom-protect .modal-photo.has-real-photo{background-image:var(--mosaic-photo,var(--modal-photo));background-size:contain;background-repeat:no-repeat;background-position:center;image-rendering:pixelated;filter:saturate(.82) contrast(.9);border-radius:0}.photo-modal.zoom-protect .modal-photo.has-real-photo:after{content:''!important;display:block!important;position:absolute;inset:0;background:linear-gradient(135deg,rgba(255,255,255,.08),rgba(0,0,0,.08)),repeating-linear-gradient(0deg,rgba(255,255,255,.06) 0 1px,transparent 1px 12px),repeating-linear-gradient(90deg,rgba(0,0,0,.06) 0 1px,transparent 1px 12px);z-index:2}

      .cover.opened .envelope-flap,.cover.zooming .envelope-flap{opacity:1!important;z-index:6!important;backface-visibility:visible!important;transform:rotateX(178deg)!important}.cover.opened .photo-card{z-index:4}.cover.zooming .photo-card{z-index:4!important}

      /* Layer correction: photo stays on top, but the opened triangular flap still peeks behind it. */
