    <meta name="twitter:title" content="송형우 · 강혜진 결혼합니다" />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://www.hyungwoosong.com/assets/wedding-og-card-20260703-7.png" />
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIINfQ0Yt3gSOOo5iUGu7hTT5m2GrHCfE=" crossorigin="" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <style>
      @import url("https://cdn.jsdelivr.net/gh/orioncactus/pretendard/dist/web/static/pretendard.css");
      @import url("https://fonts.googleapis.com/css2?family=Noto+Serif+KR:wght@400;500&display=swap");
      :root{
        --ink:#111;
        --muted:#666;
        --line:rgba(17,17,17,.16);
        --paper:#fff;
        --shadow:0 24px 80px rgba(0,0,0,.08);
        --serif:'Noto Serif KR','AppleMyungjo',Georgia,'Times New Roman',serif;
        --sans:'Pretendard','Apple SD Gothic Neo','Noto Sans KR',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;
        --dot:url('/assets/wedding-envelope-dots.svg');
        --main-photo:url('/assets/wedding-main-polaroid-transparent.png');
      }
      *{box-sizing:border-box}
      html{scroll-behavior:smooth}
      body{margin:0;background:#fff;color:var(--ink);font-family:var(--sans);line-height:1.72;letter-spacing:-.02em;-webkit-font-smoothing:antialiased}
      body.opening{overflow:hidden}
      a{color:inherit;text-decoration:none}

      /* First screen: only the envelope. The flap is a real triangular layer attached to the pocket. */
      .cover{position:fixed;inset:0;z-index:100;display:grid;place-items:center;background:#fff;transition:opacity .32s ease .05s,visibility .32s ease .05s}
      .cover.done{opacity:0;visibility:hidden;pointer-events:none}
      .envelope-button{appearance:none;border:0;background:transparent;padding:0;width:min(90vw,440px);aspect-ratio:154/110;height:auto;max-height:350px;position:relative;cursor:pointer;perspective:1100px;-webkit-tap-highlight-color:transparent}
      .envelope-button:focus-visible{outline:2px solid #111;outline-offset:10px}
      .envelope{position:absolute;inset:0;isolation:isolate}
      .photo-card{position:absolute;left:50%;bottom:30%;width:75%;aspect-ratio:1338/988;transform:translate(-50%,72%) scale(.92);opacity:0;background-image:var(--main-photo);background-size:contain;background-repeat:no-repeat;background-position:center;border:0;border-radius:2px;box-shadow:none;z-index:2;transition:transform .95s cubic-bezier(.16,.9,.2,1) .2s,opacity .28s ease .2s,box-shadow .8s ease}
      .photo-card:before{content:none}
      .envelope-back{position:absolute;left:0;right:0;bottom:0;height:70%;background:#fbf7e8;background-image:var(--dot);background-size:100% auto;background-position:center bottom;border:1.2px solid rgba(17,17,17,.22);box-shadow:0 18px 42px rgba(0,0,0,.12);z-index:1;overflow:hidden}
      .envelope-pocket{position:absolute;left:0;right:0;bottom:0;height:70%;background:#fbf7e8;background-image:var(--dot);background-size:100% auto;background-position:center bottom;border:1.2px solid rgba(17,17,17,.22);box-shadow:0 18px 42px rgba(0,0,0,.12);z-index:3;overflow:hidden}
      .envelope-pocket:before{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:rgba(17,17,17,.14);box-shadow:0 1px 0 rgba(255,255,255,.46),0 3px 8px rgba(17,17,17,.035);z-index:2}
      .envelope-flap{position:absolute;left:0;right:0;top:30%;height:50%;background:#fbf7e8;background-image:var(--dot);background-size:100% auto;background-position:center top;border-top:1.2px solid rgba(17,17,17,.22);clip-path:polygon(0 0,100% 0,50% 100%);transform-origin:50% 0;transform:rotateX(0deg);backface-visibility:visible;z-index:4;filter:drop-shadow(0 1px 0 rgba(17,17,17,.10));transition:transform .82s cubic-bezier(.18,.82,.23,1),z-index 0s linear .82s}
      .envelope-flap:after{content:'';position:absolute;left:0;right:0;top:0;height:1px;background:rgba(17,17,17,.14);box-shadow:0 1px 0 rgba(255,255,255,.46);z-index:2}
      .cover.opened .envelope-flap{transform:rotateX(178deg);z-index:5}
      .cover.opened .photo-card{opacity:1;transform:translate(-50%,-34%) scale(1)}
      .cover.zooming .photo-card{transform:translate(-50%,-48%) scale(2.28);box-shadow:0 28px 80px rgba(0,0,0,.22);z-index:4}
      .cover.zooming .envelope-pocket,.cover.zooming .envelope-back{opacity:.1;transform:translateY(40px) scale(.96);transition:opacity .55s ease,transform .55s ease}
      .cover.zooming .envelope-flap{opacity:1;transform:rotateX(178deg);transition:transform .82s cubic-bezier(.18,.82,.23,1)}

      .mobile-shell{width:min(100%,520px);min-height:100svh;margin:0 auto;background:#fff;opacity:0;transform:scale(.985);transition:opacity .55s ease,transform .55s ease;box-shadow:0 0 0 1px rgba(17,17,17,.06)}
      .body-ready .mobile-shell{opacity:1;transform:none}
      .section{padding:64px 24px;border-top:0;background:#fff;text-align:center}.center{text-align:center}.first-screen{min-height:100svh;display:flex;align-items:center;justify-content:center;padding:56px 24px 76px;border-top:0}.kicker{font-size:.76rem;letter-spacing:.22em;text-transform:uppercase;color:#111;font-weight:800;margin-bottom:12px}.section h2{font-family:var(--serif);font-weight:400;font-size:clamp(2.02rem,8.8vw,2.2rem);line-height:1.1;margin:0 0 20px;letter-spacing:-.045em;text-align:center;text-wrap:balance}
      .postcard{width:100%;max-width:420px;margin:0 auto;padding:44px 26px;text-align:center;background:#fff;border:0;border-radius:0;box-shadow:none}
      .postcard:before{content:'WEDDING INVITATION';display:block;text-align:center;margin-bottom:24px;color:#666;font-size:.76rem;letter-spacing:.22em}.postcard:after{content:'';display:none}
      .postcard-photo{width:100%;max-width:340px;aspect-ratio:1338/988;margin:0 auto 34px;background-image:var(--main-photo);background-size:contain;background-repeat:no-repeat;background-position:center;background-color:transparent;border:0;border-radius:0;box-shadow:none;position:relative;overflow:visible;cursor:zoom-in;-webkit-touch-callout:none;user-select:none}.postcard-photo:before{content:none}.postcard-names{font-family:var(--serif);font-size:2.05rem;line-height:1.18;letter-spacing:-.05em;margin:0 0 16px}.postcard-names span{font-family:var(--serif);font-size:.86em;letter-spacing:0;color:#111}.family-line{font-size:.95rem;line-height:1.75;color:#555;margin:0 0 32px}.line{display:inline-block;white-space:nowrap}.date-time-line,.address-one-line{display:inline-block;white-space:nowrap;font-size:clamp(.88rem,3.75vw,1.15rem);letter-spacing:-.04em}.core-message{font-size:clamp(.94rem,3.82vw,1.03rem);line-height:1.92;letter-spacing:-.035em;color:#111;word-break:keep-all;margin:0 auto 34px;max-width:340px}.event-line{font-size:clamp(1.02rem,4.3vw,1.18rem);line-height:1.72;margin-top:34px;border-top:1px solid var(--line);padding-top:28px;text-wrap:balance}.stable-text,.info-value,.gallery-copy,.address-line,.voice-card p,.route-guide p,.route-guide small{word-break:keep-all;overflow-wrap:normal;text-wrap:balance}
      .info-card{background:#fff;border:1px solid var(--line);border-radius:28px;padding:24px;text-align:center}.info-card+.info-card{margin-top:14px}.info-label{font-size:.8rem;color:var(--muted);letter-spacing:.08em;text-transform:uppercase}.info-value{font-size:clamp(1.04rem,4.25vw,1.15rem);font-weight:760;margin-top:4px}.calendar{margin:20px 0 14px;text-align:center}.calendar-head{display:flex;align-items:center;justify-content:center;gap:12px;margin:0 2px 14px}.calendar-month{font-family:var(--serif);font-size:1.32rem;letter-spacing:-.04em}.calendar-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:8px}.calendar span{aspect-ratio:1;border-radius:999px;display:grid;place-items:center;color:#766a60;font-size:.84rem}.calendar .dow{font-size:.72rem;color:var(--muted);aspect-ratio:auto}.calendar .day{background:#fff}.calendar .target{background:#111;color:#fff;box-shadow:0 8px 18px rgba(0,0,0,.14)}.countdown{display:grid;grid-template-columns:repeat(4,1fr);gap:9px;margin-top:20px;text-align:center}.countdown div{border:1px solid var(--line);border-radius:18px;background:#fff;padding:10px 4px;text-align:center}.countdown strong{display:block;font-size:1.25rem;text-align:center}.countdown span{font-size:.7rem;color:var(--muted);display:block;text-align:center}
      .gallery{display:grid;grid-template-columns:1fr 1fr;gap:10px}.tile{min-height:172px;border-radius:24px;background:#fff;border:1px solid #111;display:grid;place-items:center;color:#777;font-family:var(--serif);letter-spacing:.14em;position:relative;overflow:hidden;cursor:zoom-in;-webkit-touch-callout:none;user-select:none}.tile:before{content:'';position:absolute;inset:10px;border:1px solid rgba(17,17,17,.1);border-radius:18px}.tile:first-child{grid-column:1/3;min-height:220px}
      .gallery-section{background:#fff;color:#111;border-top:0;padding:76px 18px}.gallery-section .kicker,.gallery-section h2{color:#111}.gallery-copy{max-width:360px;margin:-8px auto 28px;color:#666;text-align:center;word-break:keep-all}.photo-collage{height:770px;max-width:440px;margin:0 auto;position:relative;background:#fff;overflow:visible}.collage-frame{position:absolute;appearance:none;border:10px solid #fff;background:#fff;padding:0;box-shadow:0 10px 24px rgba(0,0,0,.16);cursor:pointer;transform:rotate(var(--r,0deg));transition:transform .25s ease,box-shadow .25s ease;display:grid;place-items:center;color:#999;font-family:var(--serif);letter-spacing:.12em;aspect-ratio:var(--photo-ratio,2 / 3);height:auto!important}.collage-frame:before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,#e9e9e9,#fff 45%,#d7d7d7);z-index:0}.collage-frame span{position:relative;z-index:1;font-size:.8rem}.collage-frame:hover{transform:rotate(var(--r,0deg)) translateY(-4px);box-shadow:0 18px 34px rgba(0,0,0,.22)}.f1{left:38px;top:0;width:178px;--r:-.5deg}.f2{right:16px;top:166px;width:176px;--r:.8deg}.f3{left:0;top:292px;width:112px;z-index:2;--r:-1.5deg}.f4{left:122px;top:324px;width:168px;z-index:3;--r:.4deg}.f5{right:0;top:272px;width:128px;--r:1deg}.f6{left:12px;top:548px;width:148px;--r:-.8deg}.f7{right:22px;top:534px;width:156px;--r:.7deg}.f8{left:250px;top:12px;width:98px;--r:1.2deg}.f9{left:84px;top:548px;width:100px;--r:-1deg}.photo-modal{position:fixed;inset:0;z-index:120;background:rgba(0,0,0,.86);display:none;align-items:center;justify-content:center;padding:clamp(14px,4vw,28px);backdrop-filter:blur(10px)}.photo-modal.show{display:flex}.modal-photo-shell{margin:0 auto 34px;width:min(calc(100vw - 44px),560px);max-width:100%;position:relative;text-align:center;color:#fff;background:transparent;padding:0;border-radius:0;box-shadow:none;transform:none;display:flex;flex-direction:column;align-items:center}.modal-photo{aspect-ratio:3/4;width:min(100%,calc(82svh * .75));max-height:82svh;margin:0 auto;background:transparent;border:0;box-shadow:none;display:grid;place-items:center;color:#999;font-family:var(--serif);letter-spacing:.14em;position:relative;overflow:hidden;cursor:zoom-in}.modal-photo:before{content:'';position:absolute;inset:0;background:linear-gradient(135deg,#e8e8e8,#fff 45%,#d2d2d2);z-index:0}.modal-photo span{position:relative;z-index:1}.modal-photo-shell figcaption{position:absolute;left:0;right:0;bottom:-30px;margin:0;color:#fff;font-size:.92rem;font-family:var(--serif);letter-spacing:.08em;text-shadow:0 2px 10px rgba(0,0,0,.32)}.modal-close,.modal-nav{position:fixed;border:0;background:transparent;color:#fff;border-radius:999px;display:grid;place-items:center;z-index:121;text-shadow:0 2px 12px rgba(0,0,0,.65)}.modal-close{top:18px;right:18px;width:42px;height:42px;font-size:1.55rem;background:rgba(0,0,0,.18)}.modal-nav{top:50%;width:46px;height:72px;font-size:2.6rem;transform:translateY(-50%);opacity:.9}.modal-nav.prev{left:8px}.modal-nav.next{right:8px}@media(max-width:420px){.photo-collage{height:730px}.f1{left:38px;width:158px}.f2{right:0;top:158px;width:160px}.f4{left:116px;top:314px;width:156px}.f7{right:8px;top:512px;width:148px}.modal-nav{width:40px;height:40px}.modal-nav.prev{left:8px}.modal-nav.next{right:8px}}

      .location-section{padding-bottom:84px}.venue-first{margin-bottom:16px}.location-head{padding:0 2px;text-align:center}.mapbox{height:260px;border-radius:24px;background:#f4f4f4;border:1px solid #111;position:relative;overflow:hidden;margin-bottom:16px;display:block;box-shadow:0 10px 28px rgba(0,0,0,.06)}.interactive-map .leaflet-control-attribution{font-size:10px}.interactive-map .leaflet-popup-content{margin:10px 12px;font-family:var(--sans);letter-spacing:-.02em}.interactive-map .leaflet-popup-content strong{display:block;margin-bottom:2px}.address-line{margin:8px 0 0;color:var(--muted)}.button-row{display:grid;grid-template-columns:1fr 1fr;gap:10px;margin-top:16px}.map-buttons{grid-template-columns:1fr 1fr;gap:10px;margin-bottom:16px}.btn{display:flex;justify-content:center;align-items:center;min-height:48px;border-radius:999px;background:#111;color:#fff;font-weight:760}.btn.secondary{background:#fff;color:#111;border:1px solid var(--line)}.route-guide{display:grid;gap:12px;margin-top:16px}.route-guide article{border:1px solid var(--line);border-radius:24px;padding:20px 18px;background:#fff;text-align:left}.route-guide h3{margin:0 0 8px;font-size:1.05rem;letter-spacing:-.03em}.route-stop{margin-top:24px}.route-stop:first-of-type{margin-top:0}.route-stop h4{margin:0 0 10px;font-size:1.1rem;letter-spacing:-.035em}.shuttle-label{font-weight:500;color:#111;background:linear-gradient(transparent 52%,rgba(255,221,87,.68) 52%);padding:0 .08em}.route-guide p{margin:0;color:#555;line-height:1.78;word-break:keep-all}.route-guide small{display:block;margin-top:6px;color:#666;font-size:.92em;line-height:1.7;word-break:keep-all}.route-guide strong{color:#111;font-weight:780}.route-keep{display:inline-block;white-space:nowrap}.route-line{display:inline-block;white-space:nowrap}@media(max-width:380px){.route-guide article{padding-left:16px;padding-right:16px}.route-guide p{font-size:.96rem;letter-spacing:-.045em}.route-guide small{font-size:.88em;letter-spacing:-.045em}}
      .account-list{display:grid;gap:10px}.account{display:flex;justify-content:space-between;gap:14px;align-items:center;background:#fff;border:1px solid var(--line);border-radius:20px;padding:14px 16px;text-align:left}.account>div{min-width:0;flex:1}.account small{display:block;color:var(--muted);text-align:left}.copy{border:0;background:#f0f0f0;border-radius:999px;padding:.48rem .7rem;font-weight:760;color:#111;flex:0 0 auto}.contact-buttons .btn{min-height:62px;flex-direction:column;gap:1px;line-height:1.25}.contact-copy{border:0;font:inherit;cursor:pointer}.contact-copy.secondary{border:1px solid var(--line)}.contact-buttons span{font-size:.78rem;opacity:.72}.contact-buttons strong{font-size:.92rem;font-weight:760}.final{padding:76px 24px 92px;text-align:center}.final-message{font-family:var(--sans);font-size:clamp(.9rem,3.62vw,1.16rem);font-weight:430;line-height:1.86;letter-spacing:-.065em;word-break:keep-all;max-width:none;width:100%;margin:0 auto 22px;color:#111}.final-message .gap{display:block;height:.7em}.final-message .line{white-space:nowrap}.floating-nav{position:sticky;bottom:12px;z-index:5;padding:0 14px 14px}.floating-nav nav{display:grid;grid-template-columns:repeat(4,1fr);gap:4px;background:rgba(17,17,17,.9);backdrop-filter:blur(16px);border-radius:999px;padding:6px;box-shadow:0 18px 50px rgba(17,17,17,.18)}.floating-nav a{color:#fff;text-align:center;font-size:.75rem;padding:9px 4px;border-radius:999px}
      .account-group{border:1px solid var(--line);border-radius:24px;background:#fff;overflow:hidden}.account-group summary{list-style:none;display:flex;justify-content:space-between;align-items:center;padding:18px 20px;font-weight:780;cursor:pointer}.account-group summary::-webkit-details-marker{display:none}.account-group summary:after{content:'▾';font-size:1.05rem;line-height:1;color:#111;font-weight:800}.account-group[open] summary:after{content:'▴'}.account-group .account-list{padding:0 12px 14px}.account-group .account{border-radius:18px;background:#fafafa}.account-role{font-size:.78rem;color:var(--muted);margin-right:.35em;font-weight:600}
