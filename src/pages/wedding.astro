<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex" />
    <meta property="og:title" content="송형우 · 강혜진 결혼합니다" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.hyungwoosong.com/wedding" />
    <meta property="og:image" content="https://www.hyungwoosong.com/assets/wedding-og-card-20260703-7.png" />
