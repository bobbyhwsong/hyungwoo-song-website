---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { thoughts } from '../../data/thoughts';
---
<BaseLayout title="생각 — Hyungwoo Song" lang="ko"><section class="page-hero thoughts-hero"><div class="wrap"><div class="eyebrow">Thoughts</div><h1 class="page-title">논문이 되지 않아도 남겨두고 싶은 것들.</h1><p class="lead">읽은 것, 본 것, 연구하다가 걸린 질문을 조금 덜 정리된 상태로 둡니다.</p></div></section><section class="section tight"><div class="wrap thought-index">{thoughts.map((thought, i)=><a class={`thought-row tone-${i % 4}`} href={`/ko/thoughts/${thought.slug}/`}><div class="note-number">{String(i+1).padStart(2,'0')}</div><div><span class="stamp">{thought.kind.ko} · {thought.tags.slice(0,2).join(' · ')}</span><h2>{thought.title.ko}</h2><p>{thought.excerpt.ko}</p></div><span class="arrow">→</span></a>)}</div></section></BaseLayout>