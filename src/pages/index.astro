---
import BaseLayout from '../layouts/BaseLayout.astro';
import PublicationList from '../components/PublicationList.astro';
import { publications } from '../data/publications';
import { profile } from '../data/profile';
---
<BaseLayout title="Hyungwoo Song — HCI Researcher" lang="en" description="Hyungwoo Song is a Ph.D. student at Seoul National University studying human-centered AI, accessibility, education, and healthcare.">
  <section class="hero hero-minimal"><div class="wrap hero-grid"><div><div class="eyebrow">Seoul National University · HCI</div><h1>I study what happens when AI enters people’s everyday lives.</h1><p class="lead">I am a Ph.D. student in Intelligence and Information at Seoul National University. My work looks at how people understand, question, and adapt AI systems in their own situations.</p><p class="sublead">The question I keep returning to is simple: as technology takes over more tasks, where do human judgment, voice, and relationships remain?</p><div class="hero-tags"><span>accessibility</span><span>healthcare</span><span>learning</span><span>AI agents</span></div><div class="cta-row"><a class="btn" href="/publications/">Publications</a><a class="btn secondary" href="/about/">About</a><a class="btn secondary" href={profile.cv}>CV</a></div></div><aside class="hero-side compact"><figure class="portrait-card"><img src={profile.portrait} alt="Portrait of Hyungwoo Song"><figcaption class="portrait-caption">Hyungwoo Song · Ph.D. student</figcaption></figure></aside></div></section>
  <section class="section tight"><div class="wrap statement-panel quiet"><p>In one sentence</p><h2>I care less about AI that simply makes things faster, and more about AI that leaves people room to interpret, decide, and explain their own lives.</h2></div></section>
  <section class="section tight"><div class="wrap"><div class="section-kicker">On this site</div><div class="hub-grid"><a class="portal-card research" href="/research/"><span>01</span><h2>Research</h2><p>The questions shaping my Ph.D. work.</p></a><a class="portal-card publications" href="/publications/"><span>02</span><h2>Publications</h2><p>Papers with filters for awards, authorship, and paper type.</p></a><a class="portal-card notes" href="/thoughts/"><span>03</span><h2>Thoughts</h2><p>Notes before they become papers, plus things I read and watch.</p></a><a class="portal-card life" href="/about/"><span>04</span><h2>About</h2><p>A short introduction to how I think and work.</p></a></div></div></section>
  <section class="section"><div class="wrap split-section"><div><div class="section-kicker">Selected work</div><h2>Representative papers</h2><p class="section-copy">Work across accessibility, healthcare, information access, and human-centered AI.</p><a class="pill dark" href="/publications/">All publications →</a></div><PublicationList publications={publications} selected={true} /></div></section>
</BaseLayout>
